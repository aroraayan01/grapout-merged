APP_NAME="GrapOut Trade"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001
# The URL prefix the app is served under. Set to /trade in production
# (grapout.com/trade); leave empty locally, where the dev server strips it.
#
# NOT called APP_BASE_PATH. That name belongs to Laravel, which reads it to
# find the app on disk — and reads it with isset(), so even an empty value
# counts. Setting it here sent `Application::inferBasePath()` to '' and the
# whole test suite died on `require '/bootstrap/app.php'`, which reads as a
# broken checkout rather than as a name collision.
APP_URL_PREFIX=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=grapout_trade
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- My PA ---
FRONTEND_URL=http://localhost:5174/trade
APP_ID_PREFIX=NV
APP_ID_START=100001

# WebRTC (Phase 4)
STUN_SERVER_URL=
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8081
REVERB_INTERNAL_HOST=127.0.0.1

# Cashfree Payment Gateway (sandbox first — see DEPLOYMENT.md)
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01

# Billing / tax
BILLING_TAX_LABEL=GST
BILLING_TAX_PERCENT_BP=1800
BILLING_SELLER_NAME="My PA"
BILLING_SELLER_ADDRESS=
BILLING_SELLER_TAX_NUMBER=

# Web push (generate with: php -r "require 'vendor/autoload.php'; print_r(Minishlink\WebPush\VAPID::createVapidKeys());")
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mypa.local

# Voice assistant AI fallback (optional - Anthropic API key; rules-only when empty)
VOICE_AI_KEY=
VOICE_AI_MODEL=claude-opus-5

# LiveKit SFU (optional). Off means meetings run as a peer-to-peer mesh, which
# costs nothing to host and stops being usable past six or eight people because
# everybody uploads their own picture once per peer. With an SFU each person
# sends one stream and the server copies it out, which is what makes a large
# meeting possible — and moves the bandwidth cost onto us.
# Install with: bash deploy/cpanel/setup-livekit.sh
LIVEKIT_ENABLED=false
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Leave empty to use the SFU for every meeting. Set a number to keep smaller
# rooms peer-to-peer, where direct is genuinely better: lower latency, no bill.
LIVEKIT_MESH_UP_TO=

# --- Sign-up protection ------------------------------------------------
# Three layers keep scripts off the sign-up and public booking forms. The
# honeypot and the timing check are always on and need nothing here.
#
# Turnstile is Cloudflare's challenge: free, usually invisible to a real
# person, and the only layer that survives an attacker who has read the page.
# Create a widget at dash.cloudflare.com -> Turnstile, then set both halves.
# With no key set it is skipped entirely and the other two still apply.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# How fast a submission has to be before it is treated as a script. Nobody
# reads a sign-up form, picks a username and types a password in under this.
SIGNUP_MIN_SECONDS=3

# --- Grap Company -----------------------------------------------------------
# Name a company, get the people at it. Needs a web-search key and a
# verification key; without them the tab says so rather than failing on the
# first press. Sharing GrapUp's keys means sharing its rate limit and its bill.
SERPER_API_KEY=
VERIFIER_PROVIDER=clearout
CLEAROUT_API_TOKEN=
# HUNTER_API_KEY=

# What one company may cost, across everybody at it.
GRAPUP_MAX_VERIFICATIONS=60

# The free tier that runs before the paid one. Our own engine: syntax, DNS and
# a Microsoft directory lookup settle most addresses for nothing, and 88% of
# the credits spent without it bought the verdict "undeliverable". Leave
# INBOXX_API_KEY empty to disable — verification still works, it just costs
# what it cost before.
VERIFIER_PREFILTER=inboxx
INBOXX_API_KEY=
INBOXX_BASE_URL=https://inboxx.work
# How sure a *guess* must be to be kept without paying. Anything the engine
# actually proved is kept whatever this says.
VERIFIER_PREFILTER_THRESHOLD=80
