# ─── Production environment (used by docker-compose.prod.yml) ───
# deploy.sh generates a real .env from this. To do it by hand, copy to .env and
# fill every value below.

# Public address of your server. Use https URLs if you put it behind TLS
# (Caddy/nginx). If you only have an IP, use http://<IP>:<port>.
WEB_PUBLIC_URL=http://YOUR_SERVER_IP:3000
APP_PUBLIC_URL=http://YOUR_SERVER_IP:4000
# The browser calls the API at this URL — must be reachable from the user's
# browser (baked into the web bundle at build time).
NEXT_PUBLIC_API_URL=http://YOUR_SERVER_IP:4000/api/v1

# Where the app ports bind. Behind a reverse proxy (cPanel/nginx), set
# 127.0.0.1 so 3000/4000 aren't exposed publicly. Leave unset (0.0.0.0) to reach
# the app directly on the server IP.
BIND_HOST=0.0.0.0

# PostgreSQL password (container-internal). Use a long random value.
#   openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME

# Auth secrets — REQUIRED and must be strong (the API refuses to boot otherwise).
#   openssl rand -base64 48
JWT_ACCESS_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
# Credential encryption key — 32 bytes, base64:
#   openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=CHANGE_ME

# ─── Preset admin (no signup needed) ───
# Your super-admin is auto-created on first boot from these. Set a STRONG
# password; you can change it later in-app (My Account). Changing it here after
# first boot does NOT reset it — the account already exists.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_STRONG

# Keep public "create workspace" signup OFF — the login page then shows only
# sign-in + the client portal link. Set true only if you must create a workspace.
ALLOW_ADMIN_SIGNUP=false

# ─── LinkedIn channel (Unipile + AI) ────────────────────────
# Required for live LinkedIn automation in prod. QUEUE_ENABLED is already true
# (set in docker-compose.prod.yml). Leave any of these blank to keep LinkedIn
# "not configured" — the connect button then reports it instead of failing.
#
# UNIPILE_DSN is host:port ONLY — copy it EXACTLY as shown in the Unipile
# dashboard, with NO https:// scheme and NO trailing slash (the code adds https://).
#   correct:   api1.unipile.com:13111
#   wrong:     https://api1.unipile.com:13111   (scheme)   api1.unipile.com  (no port)
UNIPILE_DSN=CHANGE_ME
UNIPILE_API_KEY=CHANGE_ME
# Shared secret guarding the account webhook. Generate one:  openssl rand -hex 24
UNIPILE_WEBHOOK_SECRET=CHANGE_ME_STRONG
# Keep Unipile's messaging webhook pointed at APP_PUBLIC_URL automatically.
# "false" leaves it alone. Replies still arrive either way — the 3-hourly
# sync sweep is the backstop — but only the webhook makes them instant.
UNIPILE_WEBHOOK_SYNC=true
# THIS API's public base URL — no trailing slash. It builds the hosted-auth
# notify_url ( <APP_PUBLIC_URL>/api/v1/linkedin/webhooks/unipile/accounts ) that
# Unipile calls when an account finishes connecting. It MUST be reachable from
# Unipile's servers over the public internet, or seats stay stuck on PENDING
# forever. Use your https domain in production, not localhost / a private IP.
APP_PUBLIC_URL=https://api.yourdomain.com
# Optional white-label for the LinkedIn connect wizard. Unipile's only white-label
# lever is a custom domain: create a CNAME (auth.yourdomain.com → account.unipile.com),
# have Unipile support validate it + issue the SSL cert (needs an active Unipile
# subscription), then set the host here. We rewrite the wizard URL onto it so the
# client sees YOUR domain instead of unipile.com. Leave blank to use Unipile's default.
# Note: only the domain becomes yours — Unipile doesn't allow changing the page's logo/name.
UNIPILE_HOSTED_AUTH_DOMAIN=
ANTHROPIC_API_KEY=CHANGE_ME
AI_MODEL=claude-sonnet-5

# ─── WhatsApp (self-hosted portal) ──────────────────────────
# Powers WhatsApp number verification (OTP) and WhatsApp alerts. Messages go
# through our own portal, which holds one WhatsApp number per project — no Meta
# Business API, no per-message fee.
#
# PREFER THE APP: admins set the portal URL + API key per workspace under
# "WhatsApp notifications" (stored encrypted, with a Test connection button).
# These env vars are only the FALLBACK for workspaces that haven't saved their
# own — handy if you run a single workspace and would rather configure it once.
#
# Setup: create a project in the portal, link its WhatsApp number, then copy the
# project's API key from "Integration details" on the project card.
#
# Leave BOTH blank to keep WhatsApp off — in-app + email alerts still work, and
# the verification card in My Account reports that it isn't configured.
#
# WA_PORTAL_URL is the portal's public base URL, no trailing slash. It must be
# reachable from the API container (a public https URL, or the portal's address
# on the same docker network).
WA_PORTAL_URL=
WA_PORTAL_API_KEY=
#
# Telegram, if this workspace uses it: a separate project in the same portal,
# with its own linked account and its own API key. Independent of WhatsApp —
# either, both, or neither.
TG_PORTAL_URL=
TG_PORTAL_API_KEY=
# Brand name shown in the OTP message ("123456 is your Grapme verification code").
# Deep links in WhatsApp alerts reuse WEB_PUBLIC_URL — nothing extra to set.
APP_NAME=Grapme

# Only needed if the portal runs on THIS server behind a private address. The
# host resolves it via /etc/hosts, but containers never inherit that file, so the
# API container chases the public IP instead and the connection times out. This
# pins the name to the right IP inside the container; TLS still validates because
# the hostname is unchanged. Format "host:ip". Leave blank otherwise.
#   WA_PORTAL_HOST_ENTRY=wa.example.com:10.131.0.5
WA_PORTAL_HOST_ENTRY=
