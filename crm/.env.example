# ─── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://aeo:aeo_password@localhost:5432/aeo?schema=public"

# ─── Redis (queues, cache, rate-limit) ──────────────────────
REDIS_HOST="localhost"
REDIS_PORT=6379
# Set to false to run WITHOUT Redis (no background sending engine).
# The full app — auth, campaigns, approvals, contacts — works with only Postgres.
QUEUE_ENABLED=true
# Keep the queue on (LinkedIn engine runs) but disable the EMAIL sending engine.
# Handy to test LinkedIn outreach without any risk of sending email. Default: true.
EMAIL_ENGINE_ENABLED=true

# ─── API ────────────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"
# Public URL of the web app — used to build client email-confirmation links.
# Falls back to CORS_ORIGIN when unset.
WEB_PUBLIC_URL="http://localhost:3000"

# ─── Auth ───────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# ─── Credential encryption (AES-256-GCM) ────────────────────
# 32-byte key, base64 encoded. Generate: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY="REPLACE_WITH_BASE64_32_BYTE_KEY"

# ─── Sending engine ─────────────────────────────────────────
# Public base URL the recipient's mail client can reach for open/click/unsub.
# In production this is your tracking domain (e.g. https://track.yourdomain.com).
APP_PUBLIC_URL="http://localhost:4000"
# Dispatcher scan cadence (ms) and IMAP reply poll cadence (ms)
DISPATCH_SCAN_MS=60000
REPLY_POLL_MS=300000

# ─── LinkedIn channel (Unipile + AI) ────────────────────────
# Unipile powers LinkedIn automation. Blank = UI works, no live actions.
# Live campaign execution also needs QUEUE_ENABLED=true + Redis.
UNIPILE_DSN=""
UNIPILE_API_KEY=""
UNIPILE_WEBHOOK_SECRET="change-me"
# Optional white-label: your own domain for the LinkedIn hosted-auth (connect)
# wizard. Requires a CNAME (auth.yourdomain.com -> account.unipile.com) that
# Unipile support has validated + issued SSL for. Blank = clients see Unipile's
# default domain. Set the wrong/unvalidated domain and the connect link breaks.
UNIPILE_HOSTED_AUTH_DOMAIN=""
# Public base URL of THIS API (no trailing slash). Used to build the Unipile
# hosted-auth notify_url that flips a connecting account to CONNECTED.
# Local testing: a tunnel like https://xxxx.ngrok-free.app
APP_PUBLIC_URL=""
# Anthropic powers AI generation + Inbox AI Fetch. Blank = deterministic fallbacks.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"

# ─── WhatsApp (self-hosted portal) ──────────────────────────
# Alerts + number verification go through our own WhatsApp portal, which holds
# one WhatsApp number per project. Create a project in the portal, then copy its
# API key here ("Integration details" on the project card).
# Admins can also set these per workspace in-app (Messaging notifications); these
# env vars are the fallback for workspaces that haven't saved their own.
# Leave blank to disable that channel entirely (in-app + email still work).
WA_PORTAL_URL=""
WA_PORTAL_API_KEY=""
# Telegram is a second, independent portal project — its own account and its own
# key. Both channels can run at once; a user picks either or both in My Account.
TG_PORTAL_URL=""
TG_PORTAL_API_KEY=""
# Brand name shown in the OTP message. Deep links in WhatsApp alerts reuse
# WEB_PUBLIC_URL (above) — there is no separate URL to set here.
APP_NAME="Grapme"

# ─── Web ────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
